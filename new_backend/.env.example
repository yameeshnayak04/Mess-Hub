# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

PORT=4000
NODE_ENV=development

# --- Postgres (used by docker-compose.yml to configure the db container) ---
POSTGRES_DB=messhub
POSTGRES_USER=messhub_user
POSTGRES_PASSWORD=change_me

# Only used if you run the app OUTSIDE docker compose (e.g. running tests
# directly on your machine against the db container's exposed port). When you
# run `docker compose up`, this value is overridden automatically to point at
# the "db" service instead of localhost — see docker-compose.yml.
DATABASE_URL=postgres://messhub_user:change_me@localhost:5544/messhub

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=30d

# Shared secret the external cron job sends to trigger billing/absence jobs
CRON_SECRET=replace_with_a_long_random_string

# --- Cloudinary (image uploads: mess photos, payment proofs) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
