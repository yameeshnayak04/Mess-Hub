{
  "name": "mess-hub-new-backend",
  "version": "1.0.0",
  "description": "Mess Hub backend, rebuilt on PostgreSQL. See ../new_backend/README.md and DOCKER.md.",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "migrate:make": "knex --knexfile db/knexfile.js migrate:make",
    "migrate:latest": "knex --knexfile db/knexfile.js migrate:latest",
    "migrate:rollback": "knex --knexfile db/knexfile.js migrate:rollback",
    "test": "node --test",
    "test:api": "node scripts/apiTest.js",
    "test:contract": "node scripts/contractCheck.js",
    "test:contract:kiosk": "node scripts/kioskContractCheck.js",
    "test:contract:manager": "node scripts/managerMemberPageCheck.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3"
  }
}
